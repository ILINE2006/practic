{
    "name": "iline/pop-it-mvc",
    "description": "Simple mvc framework",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "ILINE2006",
            "email": "teplotom71@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.0",
        "illuminate/database": "12.x-dev",
        "illuminate/events": "12.x-dev",
        "nikic/fast-route": "^2.0@dev",
        "iline/collect": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "C:/xampp/htdocs/collect"
        }
    ],
    "config": {
        "platform-check": false
    },
    "autoload": {
        "psr-4": {
            "Src\\": "core/Src/",
            "": "app/"
        }
    }
}
